# Root-owned mode0600 /etc/deadswitch-grader/grader.env. No provider credentials on this node.
DS_GRADER_STATE_DIR=/var/lib/deadswitch-grader
DS_GRADER_KEY_FILE=/etc/deadswitch-grader/scorer.key
DS_CONTROLLER_PUBKEY=REPLACE_WITH_PINNED_CONTROLLER_PUBLIC_KEY_HEX
DS_GRADER_EXPECTED_OUTPUT=/etc/deadswitch-grader/expected-output.bin
DS_GRADER_LAUNCH_HOOK=/opt/deadswitch-grader/hooks/launch.sh
DS_GRADER_OBSERVE_HOOK=/opt/deadswitch-grader/hooks/observe.sh
DS_GRADER_DESTROY_HOOK=/opt/deadswitch-grader/hooks/destroy.sh
DS_GRADER_DESTROY_ALL_HOOK=/opt/deadswitch-grader/hooks/destroy-all.sh
